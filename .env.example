# Copy to .env and fill in what you need.
#
# Nothing here is required to BROWSE the dashboard — `docker compose up` serves
# it with an empty database and no keys. Keys are needed to RUN the pipeline
# (which calls the search providers) and the analytics judge.

# ───────────────────────────── Search providers ──────────────────────────────
# Providers with a missing key fail gracefully; the rest of the run still
# completes. OPENAI_API_KEY is used by the OpenAI provider, by Exa (for
# synthesis) and by Codex. ANTHROPIC_API_KEY is used by both Anthropic
# providers. The analytics judge also uses OPENAI_API_KEY.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
PERPLEXITY_API_KEY=pplx-...
EXA_API_KEY=...

# ───────────────────────────── Pipeline options ──────────────────────────────
# PROMPTS_FILE=prompts/default.csv
# TARGETS_FILE=targets.json
# OUTPUT_DIR=results
# CONCURRENCY=3
# LOG_LEVEL=info
# ANALYTICS_CONFIG=analytics.config.json

# ─────────────────────────────── Database ────────────────────────────────────
# Matches the Postgres published by docker-compose.yml. Used by @aio/db (web
# reads, ingest writes) and by drizzle-kit migrations.
#
# From the HOST (running `bun run ingest`, `drizzle-kit studio`) the host is
# localhost. Inside the compose network it is `db` — compose sets that itself,
# so you do not need to change this.
DATABASE_URL=postgres://aio:aio@localhost:5432/aio
# The driver requires SSL for any host that is not obviously localhost. Set this
# to "disable" when pointing at a plaintext Postgres on another host.
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=10

# ───────────────────────── Dashboard access control ──────────────────────────
# OFF BY DEFAULT. Leave ALLOWED_EMAIL_DOMAINS unset and the dashboard is open to
# anyone who can reach it — fine on localhost, not fine on a public address.
#
# Set it to a comma-separated list of email domains to require Google sign-in.
# Only verified Google accounts on these exact domains get in; subdomains and
# look-alikes are rejected. The other three variables then become required.
# ALLOWED_EMAIL_DOMAINS=example.com,partner.dev

# Session signing secret. Generate with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Public origin of the app. Must match the Google redirect URI's origin.
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI must be  <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
